# codex-lsp shell integration for zsh. At each prompt where the language environment (or the working
# directory) changed, it snapshots this shell's environment under an id owned by this shell.
# Generated by 'codex-lsp env shell-init zsh'.
if [[ "${__codex_lsp_installed-}" != 1 ]]; then
	__codex_lsp_installed=1
	# Each interactive shell owns a fresh id; an inherited id belongs to the parent shell.
	export CODEX_LSP_CONTEXT_ID="env-sh-$$-$RANDOM$RANDOM-$(date +%s)"
	__codex_lsp_last_key=
	__codex_lsp_prompt() {
		local __codex_lsp_status=$?
		local __codex_lsp_key=$PWD __codex_lsp_name
		for __codex_lsp_name in @NAMES@; do
			if (( ${+parameters[$__codex_lsp_name]} )); then
				__codex_lsp_key+=$'\x1f'"$__codex_lsp_name=${(P)__codex_lsp_name}"
			else
				__codex_lsp_key+=$'\x1f'"$__codex_lsp_name"
			fi
		done
		if [[ "$__codex_lsp_key" != "$__codex_lsp_last_key" ]]; then
			@NODE@ @CLI@ env capture --kind shell --shell zsh >/dev/null || printf 'codex-lsp: environment capture failed\n' >&2
			__codex_lsp_last_key=$__codex_lsp_key
		fi
		return $__codex_lsp_status
	}
	autoload -Uz add-zsh-hook
	add-zsh-hook precmd __codex_lsp_prompt
fi
