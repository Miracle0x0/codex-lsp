{
	"name": "@code-yeongyu/codex-lsp",
	"version": "0.2.0",
	"description": "Codex plugin that exposes Language Server Protocol tools and post-edit diagnostics.",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/codex-lsp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/codex-lsp.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/codex-lsp/issues"
	},
	"keywords": [
		"codex",
		"codex-plugin",
		"lsp",
		"language-server-protocol",
		"mcp",
		"diagnostics"
	],
	"bin": {
		"codex-lsp": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"skills",
		"shell",
		".codex-plugin",
		".mcp.json",
		"LICENSE",
		"NOTICE",
		"README.md",
		"CHANGELOG.md",
		"docs",
		"DESIGN-zh.md"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "node node_modules/typescript/bin/tsc --noEmit",
		"lint": "biome check src test vitest.config.ts vitest.integration.config.ts",
		"lint:fix": "biome check --write src test vitest.config.ts vitest.integration.config.ts",
		"check": "pnpm run typecheck && pnpm run lint",
		"test:integration": "vitest --run --config vitest.integration.config.ts",
		"test:package": "pnpm run build && node scripts/package-plugin.mjs --verify",
		"test:contract": "vitest --run test/codex/codex-contract.test.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.3.1",
		"vscode-jsonrpc": "9.0.3",
		"vscode-languageserver-protocol": "3.18.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@modelcontextprotocol/client": "2.3.1",
		"@types/node": "^25.7.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.5",
		"typescript6": "npm:typescript@6.0.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
