{
	"name": "@code-yeongyu/codex-lsp",
	"version": "0.2.0",
	"description": "Codex plugin that exposes Language Server Protocol tools and post-edit diagnostics.",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/codex-lsp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/codex-lsp.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/codex-lsp/issues"
	},
	"keywords": [
		"codex",
		"codex-plugin",
		"lsp",
		"language-server-protocol",
		"mcp",
		"diagnostics"
	],
	"bin": {
		"codex-lsp": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"skills",
		"shell",
		".codex-plugin",
		".mcp.json",
		"LICENSE",
		"NOTICE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src test",
		"lint:fix": "biome check --write src test",
		"check": "tsc --noEmit && biome check src test && tsc -p tsconfig.build.json",
		"build:all": "pnpm -r run build",
		"check:all": "pnpm -r run typecheck && pnpm -r run lint",
		"test:all": "pnpm -r run test",
		"test:integration": "pnpm --filter @code-yeongyu/lsp-tools-mcp run test:integration",
		"test:package": "pnpm run build:all && node scripts/package-plugin.mjs --verify"
	},
	"dependencies": {
		"@code-yeongyu/lsp-tools-mcp": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@modelcontextprotocol/client": "2.3.1",
		"@types/node": "^25.7.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
